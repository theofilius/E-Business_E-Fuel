PORT=5000

# === DATABASE ===
# Option A — Local MongoDB:
#   MONGODB_URI=mongodb://127.0.0.1:27017/efuel
# Option B — MongoDB Atlas (free tier, recommended for demo):
#   MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/efuel?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/efuel

# === AUTH ===
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=30d

NODE_ENV=development
