# ============================================================
# E-FUEL Backend — Environment Variables Template
# ============================================================
# Salin file ini menjadi .env dan isi nilai yang sesuai.
# JANGAN commit file .env asli ke GitHub.
# File .env sudah ada di .gitignore.
# ============================================================

# Port API server
# CATATAN: Port 5000 dipakai macOS AirPlay Receiver, gunakan 5001
PORT=5001

# Bind agar backend bisa diakses dari perangkat fisik di jaringan Wi-Fi yang sama
HOST=0.0.0.0

# ============================================================
# DATABASE — pilih salah satu mode
# ============================================================

# --- MODE A: Local MongoDB (untuk development) ---
# Jalankan MongoDB lokal dulu: cd backend && npm run db:local
MONGODB_URI=mongodb://127.0.0.1:27017/efuel

# --- MODE B: MongoDB Atlas (untuk demo/production) ---
# Ganti <username>, <password>, <cluster-url> dengan nilai dari Atlas dashboard.
# Database name: efuel
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/efuel?retryWrites=true&w=majority

# ============================================================
# AUTENTIKASI JWT
# ============================================================
# Ganti dengan string acak yang panjang dan kuat di production!
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=30d

# ============================================================
# ENVIRONMENT
# ============================================================
# development | production
NODE_ENV=development
