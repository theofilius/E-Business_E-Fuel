# Port 5000 is used by macOS AirPlay Receiver — using 5001 instead
PORT=5001

# === DATABASE ===
# Local MongoDB (development) — used by `npm run db:local`
MONGODB_URI=mongodb://127.0.0.1:27017/efuel
# MongoDB Atlas (production / demo) — paste your own connection string here:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/efuel?retryWrites=true&w=majority

# === AUTH ===
JWT_SECRET=efuel_jwt_secret_key_2024_change_in_production
JWT_EXPIRE=30d

NODE_ENV=development
